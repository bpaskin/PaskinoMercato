<?xml version="1.0" encoding="UTF-8"?>
<ejbbnd:EJBJarBinding xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ejbbnd="ejbbnd.xmi"
    xmlns:ejb="ejb.xmi"
    xmi:id="EJBJarBinding_1">

    <ejbJar href="META-INF/ejb-jar.xml#ejb-jar_ID"/>

    <!-- Session bean JNDI home bindings -->
    <ejbBindings xmi:id="EnterpriseBeanBinding_Catalogo"
        jndiName="ejb/it/paskinomercato/ejb/catalogo/CatalogoLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#CatalogoBean"/>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Ordine"
        jndiName="ejb/it/paskinomercato/ejb/ordine/OrdineLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#OrdineBean"/>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Cliente"
        jndiName="ejb/it/paskinomercato/ejb/cliente/ClienteLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#ClienteBean"/>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Carrello"
        jndiName="ejb/it/paskinomercato/ejb/carrello/CarrelloLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#CarrelloBean"/>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Mail"
        jndiName="ejb/it/paskinomercato/ejb/mail/MailLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#MailBean"/>
    </ejbBindings>

    <!-- BMP Entity bean JNDI home bindings -->
    <ejbBindings xmi:id="EnterpriseBeanBinding_ProdottoEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/prodotto/ProdottoEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#ProdottoEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_ProdottoMercatoDB"
            jndiName="jdbc/MercatoDB">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_ProdottoMercatoDB"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_CategoriaEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/categoria/CategoriaEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#CategoriaEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_CategoriaMercatoDB"
            jndiName="jdbc/MercatoDB">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_CategoriaMercatoDB"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_ClienteEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/cliente/ClienteEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#ClienteEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_ClienteEntityMercatoDB"
            jndiName="jdbc/MercatoDB">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_ClienteEntityMercatoDB"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_OrdineEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/ordine/OrdineEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#OrdineEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_OrdineEntityMercatoDB"
            jndiName="jdbc/MercatoDB">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_OrdineEntityMercatoDB"/>
        </resRefBindings>
    </ejbBindings>

</ejbbnd:EJBJarBinding>
