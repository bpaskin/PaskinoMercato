<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.paskinomercato</groupId>
        <artifactId>paskinomercato</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>paskinomercato-ear</artifactId>
    <packaging>ear</packaging>
    <name>PaskinoMercato - EAR Module</name>

    <dependencies>
        <dependency>
            <groupId>it.paskinomercato</groupId>
            <artifactId>paskinomercato-ejb</artifactId>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>it.paskinomercato</groupId>
            <artifactId>paskinomercato-war</artifactId>
            <version>1.0.0</version>
            <type>war</type>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>copy-postgresql-driver</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.postgresql</groupId>
                                    <artifactId>postgresql</artifactId>
                                    <version>42.7.3</version>
                                    <outputDirectory>${project.build.directory}/liberty/wlp/usr/servers/paskinomercato/lib</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <configuration>
                    <version>6</version>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <jarModule>
                            <groupId>it.paskinomercato</groupId>
                            <artifactId>paskinomercato-ejb</artifactId>
                            <bundleFileName>paskinomercato-ejb.jar</bundleFileName>
                            <includeInApplicationXml>true</includeInApplicationXml>
                        </jarModule>
                        <webModule>
                            <groupId>it.paskinomercato</groupId>
                            <artifactId>paskinomercato-war</artifactId>
                            <bundleFileName>paskinomercato.war</bundleFileName>
                            <contextRoot>/paskinomercato</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <serverName>paskinomercato</serverName>
                    <serverXmlFile>${project.basedir}/src/main/liberty/config/server.xml</serverXmlFile>
                    <appsDirectory>apps</appsDirectory>
                    <installAppPackages>project</installAppPackages>
                    <!-- Download Open Liberty automatically if not already installed -->
                    <runtimeArtifact>
                        <groupId>io.openliberty</groupId>
                        <artifactId>openliberty-runtime</artifactId>
                        <version>26.0.0.7</version>
                        <type>zip</type>
                    </runtimeArtifact>
                </configuration>
                <executions>
                    <!-- generate-resources: unpack the Liberty runtime zip -->
                    <execution>
                        <id>install-liberty</id>
                        <phase>generate-resources</phase>
                        <goals><goal>install-server</goal></goals>
                    </execution>
                    <!-- process-resources: create the server dir and copy server.xml so
                         install-feature can parse the feature list from it -->
                    <execution>
                        <id>create-liberty-server</id>
                        <phase>process-resources</phase>
                        <goals><goal>create</goal></goals>
                    </execution>
                    <execution>
                        <id>install-liberty-features</id>
                        <phase>package</phase>
                        <goals><goal>install-feature</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
