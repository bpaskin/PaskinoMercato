<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://ws.paskinomercato.it/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://ws.paskinomercato.it/"
             name="MercatoService">

    <types>
        <xsd:schema targetNamespace="http://ws.paskinomercato.it/">
            <xsd:element name="getProdottoXmlRequest">
                <xsd:complexType><xsd:sequence>
                    <xsd:element name="codice" type="xsd:string"/>
                </xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="getProdottoXmlResponse">
                <xsd:complexType><xsd:sequence>
                    <xsd:element name="return" type="xsd:string"/>
                </xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="getStatoOrdineRequest">
                <xsd:complexType><xsd:sequence>
                    <xsd:element name="numeroOrdine" type="xsd:string"/>
                </xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="getStatoOrdineResponse">
                <xsd:complexType><xsd:sequence>
                    <xsd:element name="return" type="xsd:string"/>
                </xsd:sequence></xsd:complexType>
            </xsd:element>
            <xsd:element name="getCategorieXmlRequest">
                <xsd:complexType><xsd:sequence/></xsd:complexType>
            </xsd:element>
            <xsd:element name="getCategorieXmlResponse">
                <xsd:complexType><xsd:sequence>
                    <xsd:element name="return" type="xsd:string"/>
                </xsd:sequence></xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </types>

    <message name="getProdottoXmlRequest">
        <part name="parameters" element="tns:getProdottoXmlRequest"/>
    </message>
    <message name="getProdottoXmlResponse">
        <part name="parameters" element="tns:getProdottoXmlResponse"/>
    </message>
    <message name="getStatoOrdineRequest">
        <part name="parameters" element="tns:getStatoOrdineRequest"/>
    </message>
    <message name="getStatoOrdineResponse">
        <part name="parameters" element="tns:getStatoOrdineResponse"/>
    </message>
    <message name="getCategorieXmlRequest">
        <part name="parameters" element="tns:getCategorieXmlRequest"/>
    </message>
    <message name="getCategorieXmlResponse">
        <part name="parameters" element="tns:getCategorieXmlResponse"/>
    </message>

    <portType name="MercatoServiceSEI">
        <operation name="getProdottoXml">
            <input  message="tns:getProdottoXmlRequest"/>
            <output message="tns:getProdottoXmlResponse"/>
        </operation>
        <operation name="getStatoOrdine">
            <input  message="tns:getStatoOrdineRequest"/>
            <output message="tns:getStatoOrdineResponse"/>
        </operation>
        <operation name="getCategorieXml">
            <input  message="tns:getCategorieXmlRequest"/>
            <output message="tns:getCategorieXmlResponse"/>
        </operation>
    </portType>

    <binding name="MercatoServiceBinding" type="tns:MercatoServiceSEI">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="getProdottoXml">
            <soap:operation soapAction="getProdottoXml"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="getStatoOrdine">
            <soap:operation soapAction="getStatoOrdine"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
        <operation name="getCategorieXml">
            <soap:operation soapAction="getCategorieXml"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="MercatoService">
        <port name="MercatoServicePort" binding="tns:MercatoServiceBinding">
            <soap:address location="http://localhost:9080/paskinomercato/MercatoService"/>
        </port>
    </service>
</definitions>
