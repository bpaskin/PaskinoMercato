<?xml version="1.0" encoding="UTF-8"?>
<ejbbnd:EJBJarBinding xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ejbbnd="ejbbnd.xmi"
    xmlns:ejb="ejb.xmi"
    xmi:id="EJBJarBinding_1">

    <ejbJar href="META-INF/ejb-jar.xml#ejb-jar_ID"/>

    <!-- Session bean JNDI home bindings -->
    <ejbBindings xmi:id="EnterpriseBeanBinding_Catalogo"
        jndiName="ejb/it/paskinomercato/ejb/catalogo/CatalogoLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#CatalogoBean"/>
        <ejbRefBindings xmi:id="EJBRefBinding_CatalogoProdottoEntity"
            jndiName="ejb/it/paskinomercato/ejb/entity/prodotto/ProdottoEntityLocalHome">
            <bindingEjbRef
                href="META-INF/ejb-jar.xml#EJBLocalRef_CatalogoProdottoEntity"/>
        </ejbRefBindings>
        <ejbRefBindings xmi:id="EJBRefBinding_CatalogoCategoriaEntity"
            jndiName="ejb/it/paskinomercato/ejb/entity/categoria/CategoriaEntityLocalHome">
            <bindingEjbRef
                href="META-INF/ejb-jar.xml#EJBLocalRef_CatalogoCategoriaEntity"/>
        </ejbRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Ordine"
        jndiName="ejb/it/paskinomercato/ejb/ordine/OrdineLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#OrdineBean"/>
        <ejbRefBindings xmi:id="EJBRefBinding_OrdineEntity"
            jndiName="ejb/it/paskinomercato/ejb/entity/ordine/OrdineEntityLocalHome">
            <bindingEjbRef
                href="META-INF/ejb-jar.xml#EJBLocalRef_OrdineEntity"/>
        </ejbRefBindings>
        <resRefBindings xmi:id="ResourceRefBinding_OrdineJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_OrdineJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Cliente"
        jndiName="ejb/it/paskinomercato/ejb/cliente/ClienteLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#ClienteBean"/>
        <ejbRefBindings xmi:id="EJBRefBinding_ClienteEntity"
            jndiName="ejb/it/paskinomercato/ejb/entity/cliente/ClienteEntityLocalHome">
            <bindingEjbRef
                href="META-INF/ejb-jar.xml#EJBLocalRef_ClienteEntity"/>
        </ejbRefBindings>
        <resRefBindings xmi:id="ResourceRefBinding_ClienteJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_ClienteJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Carrello"
        jndiName="ejb/it/paskinomercato/ejb/carrello/CarrelloLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#CarrelloBean"/>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_DatabaseInitializer"
        jndiName="ejb/it/paskinomercato/ejb/database/DatabaseInitializerLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#DatabaseInitializerBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_DatabaseInitializerJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_DatabaseInitializerJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_Mail"
        jndiName="ejb/it/paskinomercato/ejb/mail/MailLocalHome">
        <enterpriseBean xmi:type="ejb:Session"
            href="META-INF/ejb-jar.xml#MailBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_MailMercatoMail"
            jndiName="mail/MercatoMail">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_MailMercatoMail"/>
        </resRefBindings>
        <resRefBindings xmi:id="ResourceRefBinding_MailJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_MailJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <!-- BMP Entity bean JNDI home bindings -->
    <ejbBindings xmi:id="EnterpriseBeanBinding_ProdottoEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/prodotto/ProdottoEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#ProdottoEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_ProdottoJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_ProdottoJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_CategoriaEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/categoria/CategoriaEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#CategoriaEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_CategoriaJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_CategoriaJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_ClienteEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/cliente/ClienteEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#ClienteEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_ClienteEntityJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_ClienteEntityJdbc"/>
        </resRefBindings>
    </ejbBindings>

    <ejbBindings xmi:id="EnterpriseBeanBinding_OrdineEntity"
        jndiName="ejb/it/paskinomercato/ejb/entity/ordine/OrdineEntityLocalHome">
        <enterpriseBean xmi:type="ejb:Entity"
            href="META-INF/ejb-jar.xml#OrdineEntityBean"/>
        <resRefBindings xmi:id="ResourceRefBinding_OrdineEntityJdbc"
            jndiName="jdbc/PaskinoMercatoDS">
            <bindingResourceRef
                href="META-INF/ejb-jar.xml#ResourceRef_OrdineEntityJdbc"/>
        </resRefBindings>
    </ejbBindings>

</ejbbnd:EJBJarBinding>
